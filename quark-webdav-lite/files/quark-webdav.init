#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load quark-webdav
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0
	config_get listen main listen '0.0.0.0:5244'
	config_get root_id main root_id '0'
	config_get root_path main root_path '/'
	config_get parallel main parallel '3'
	config_get chunk_mb main chunk_mb '2'
	config_get username main username 'quark'
	config_get password main password ''
	config_get cookie main cookie ''
	[ -n "$cookie" ] || { logger -t quark-webdav 'Cookie is empty'; return 1; }
	procd_open_instance
	procd_set_param command /usr/bin/quark-webdav
	procd_set_param env QUARK_LISTEN="$listen" QUARK_ROOT_ID="$root_id" QUARK_ROOT_PATH="$root_path" QUARK_PARALLEL="$parallel" QUARK_CHUNK_MB="$chunk_mb" QUARK_USERNAME="$username" QUARK_PASSWORD="$password" QUARK_COOKIE="$cookie"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger quark-webdav
}
